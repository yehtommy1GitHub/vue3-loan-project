{
  "name": "vue3-login-register-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node server/mockApiServer.js",
    "dev:full": "concurrently \"npm run dev:api\" \"npm run dev\"",
    "type-check": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "axios": "^1.9.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "vee-validate": "^4.15.1",
    "vite": "^6.2.0",
    "vue": "^3.5.13",
    "vue-next-select": "^2.10.5",
    "vue-router": "^4.5.0",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^25.9.1",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.1.2",
    "jsdom": "^25.0.1",
    "typescript": "^6.0.3",
    "vitest": "^3.0.8",
    "vue-tsc": "^3.3.1"
  }
}
