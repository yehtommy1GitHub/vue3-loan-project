# .env.example 是「範本」，會上 GitHub；.env 是「你本機真正生效的設定」，通常不會上 GitHub。
# 是否連接實際後端 API：
# false：走本機 mock API
# true：走實際後端 API
VITE_USE_BACKEND_API=true

# 本機 mock API server：
# npm run dev:api
VITE_MOCK_API_BASE_URL=http://127.0.0.1:3001

# 實際後端 API base URL，VITE_USE_BACKEND_API=true 時才會使用。
VITE_BACKEND_API_BASE_URL=http://127.0.0.1:8080

# API 逾時毫秒數。
VITE_API_TIMEOUT_MS=8000
